# Copy to .env.local and fill in. Without the Supabase keys the app runs in local mode (no login).

# Supabase: Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Checkout links from the payment provider (Kiwify, Hotmart or Stripe Payment Links)
VITE_CHECKOUT_CREATOR_URL=
VITE_CHECKOUT_AGENCY_URL=
VITE_CHECKOUT_FOUNDER_URL=

# Local mode only: plan to simulate without login (free, creator, agency, founder)
VITE_DEV_PLAN=free
